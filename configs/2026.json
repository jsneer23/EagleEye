{
  "version": 1,
  "sources": {
    "match_info": {
      "enabled": "DS:enabled",
      "autonomous": "DS:autonomous",
      "fms_control": "NT:/FMSInfo/FMSControlData"
    },
    "cameras": {
      "instances": {
        "back_right_cam": {
          "health": "/Robot//Vision/back_right_cam/April Tag Cam Connected/",
          "accepted_ts": "/Robot//Vision/back_right_cam/Accepted Time Stamp/"
        },
        "cam_back_left":  {
          "health": "/Robot//Vision/cam_back_left/April Tag Cam Connected/",
          "accepted_ts": "/Robot//Vision/cam_back_left/Accepted Time Stamp/"
        },
        "cam_back_right": {
          "health": "/Robot//Vision/cam_back_right/April Tag Cam Connected/",
          "accepted_ts": "/Robot//Vision/cam_back_right/Accepted Time Stamp/"
        },
        "cam2026_02":     {
          "health": "/Robot//Vision/cam2026_02/April Tag Cam Connected/",
          "accepted_ts": "/Robot//Vision/cam2026_02/Accepted Time Stamp/"
        }
      }
    },
    "can":{
      "instances": {
        "systemcore_0": { 
          "util": "/Robot/SystemStats/CANBus/Utilization" 
        },
        "canivore": { 
          "util": "/Robot/Canivore/Canivore Bus Utilization"
        }
      }
    },
    "power": {
        "voltage": "/Robot/SystemStats/BatteryVoltage",
        "brownout": "/Robot/SystemStats/BrownedOut"
    },
    "comms": {
        "radio_status": "/Robot/RadioStatus/StatusJson"
    }
  },
  "thresholds": {
    "brownout": {
      "defaults": { 
        "warn_voltage": 7.5,
        "brownout_voltage": 6.8,
        "merge_intervals_gap_s": 0.1,
        "min_interval_duration_s": 0.0
      }
    },
    "radio_signal": {
      "defaults": { 
        "err_dbm": -70,
        "warn_dbm": -60,
        "err_snr": 20,
        "warn_snr": 30,
        "merge_intervals_gap_s": 0.1,
        "min_interval_duration_s": 0.0
      }
    },
    "can_util": {
      "defaults": { 
        "warn_sustained_level": 0.80,
        "warn_sustained_s": 0.5,
        "warn_peak": 0.95
      },
      "overrides": {
        "canivore": { 
          "warn_sustained_level": 0.60,
          "warn_peak": 0.85 
        }
      }
    },
    "camera_health": {
      "defaults": {
        "fail_sustained_s": 1,
        "fail_pct_down": 0.05,
        "warn_sustained_s": 0.5,
        "warn_pct_down": 0.01 
      }
    },
    "april_tag_seen":{
      "defaults": {
      }
    }
  }
}
